// Galui — Knesset legislative activity tracker
// Schema mirrors the official Knesset OData v3 service (ParliamentInfo.svc).
// Hebrew payloads are stored as-is; all column names are English.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// KNS_Person + denormalised MK facts derived from KNS_PersonToPosition.
/// The OData service has no KNS_MkIndividual entity, so "is this person an MK"
/// is resolved from PersonToPosition rows with PositionID 43 / 61.
model Person {
  personId    Int     @id
  firstName   String?
  lastName    String?
  genderDesc  String?
  email       String?
  isCurrent   Boolean @default(false)

  /// True when the person holds/held an MK position in `knessetNum`.
  isMk        Boolean @default(false)
  knessetNum  Int?
  /// Current faction, taken from the PositionID 54 row.
  factionId   Int?
  factionName String?
  /// Highest-profile non-MK role (minister, committee chair...), for display.
  roleDesc    String?

  /// "coalition" | "opposition", from the curated faction map in
  /// src/lib/factions.ts. The OData service does not expose bloc membership —
  /// see the note there before trusting or changing this.
  bloc        String?
  /// Role in the *sitting* government, e.g. "שר החינוך". Null for MKs who hold
  /// no portfolio now, including ministers of a previous government.
  governmentRole String?
  /// True when governmentRole is set — kept as a column so it can be sorted on.
  isMinister  Boolean @default(false)
  mkStartDate DateTime?
  mkEndDate   DateTime?

  /// KNS_MkSiteCode.MKSiteCode.
  mkSiteCode  String?
  /// KNS_MkSiteCode.SiteId — a DIFFERENT id from mkSiteCode, and the one that
  /// knesset.gov.il member pages, the Knesset photo archive and Wikidata's
  /// P9770 all key on. Both id spaces are small integers drawn from overlapping
  /// ranges, so confusing them silently yields the wrong person rather than a
  /// miss: site code 837 is חנין זועבי, while SiteId 837 is חמד עמאר.
  siteId      Int?

  /// Headshot, sourced from Wikimedia Commons (see scripts/fetch-photos.ts).
  /// The OData service exposes no image of its own.
  imageUrl    String?
  /// Required by the CC BY-SA licence these photos carry — never render the
  /// image without it.
  imageCredit String?
  imageLicense String?
  imageSourceUrl String?

  lastUpdatedDate DateTime?

  positions  PersonPosition[]
  billsInitiated BillInitiator[]
  participations CommitteeParticipant[]
  questions  Question[]

  @@index([isMk, knessetNum])
  @@index([bloc])
  @@index([lastName])
  @@index([siteId])
}

/// KNS_PersonToPosition — one row per role a person holds in a Knesset term.
model PersonPosition {
  personToPositionId Int     @id
  personId           Int
  positionId         Int
  positionDesc       String?
  knessetNum         Int?
  startDate          DateTime?
  finishDate         DateTime?
  factionId          Int?
  factionName        String?
  dutyDesc           String?
  committeeId        Int?
  committeeName      String?
  govMinistryName    String?
  /// Which government the role belongs to. Knesset 25 spans two: the outgoing
  /// 36th still in office when the term opened, and the sitting 37th.
  governmentNum      Int?
  isCurrent          Boolean @default(false)
  lastUpdatedDate    DateTime?

  person Person @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@index([personId])
  @@index([positionId, knessetNum])
}

/// KNS_Faction
model Faction {
  factionId  Int     @id
  name       String?
  knessetNum Int?
  startDate  DateTime?
  finishDate DateTime?
  isCurrent  Boolean @default(false)
  lastUpdatedDate DateTime?

  @@index([knessetNum])
}

/// KNS_Committee
model Committee {
  committeeId       Int     @id
  name              String?
  categoryDesc      String?
  knessetNum        Int?
  committeeTypeDesc String?
  parentCommitteeId Int?
  parentName        String?
  isCurrent         Boolean @default(false)
  lastUpdatedDate   DateTime?

  sessions CommitteeSession[]
  bills    Bill[]

  parent        Committee?  @relation("Subcommittees", fields: [parentCommitteeId], references: [committeeId], onDelete: SetNull)
  subcommittees Committee[] @relation("Subcommittees")

  /// Rows where this committee is the joint one, listing its participants.
  jointParticipants JointCommittee[] @relation("JointParent")
  /// Rows where this committee takes part in someone else's joint committee.
  jointMemberships  JointCommittee[] @relation("JointParticipant")

  @@index([knessetNum])
  @@index([parentCommitteeId])
  @@index([committeeTypeDesc])
}

/// KNS_JointCommittee — which committees make up a joint committee.
///
/// `$metadata` declares `JointCommitteeID` as the key, but it is not unique —
/// the value "1" appears on many rows. The real key is the pair of committees,
/// which is what this model uses.
model JointCommittee {
  committeeId            Int
  participantCommitteeId Int
  jointCommitteeId       String?
  lastUpdatedDate        DateTime?

  committee   Committee @relation("JointParent", fields: [committeeId], references: [committeeId], onDelete: Cascade)
  participant Committee @relation("JointParticipant", fields: [participantCommitteeId], references: [committeeId], onDelete: Cascade)

  @@id([committeeId, participantCommitteeId])
  @@index([participantCommitteeId])
}

/// KNS_Status — resolves StatusID on bills and session items to Hebrew labels.
model Status {
  statusId Int     @id
  desc     String?
  typeDesc String?
  isActive Boolean @default(true)

  bills        Bill[]
  sessionItems SessionItem[]
  plenumItems  PlenumSessionItem[]
  questions    Question[]
}

/// KNS_Bill
model Bill {
  billId       Int     @id
  knessetNum   Int?
  name         String?
  subTypeId    Int?
  /// "פרטית" (private member's bill) / "ממשלתית" (government bill) / ...
  subTypeDesc  String?
  privateNumber Int?
  number       Int?
  committeeId  Int?
  statusId     Int?
  postponementReasonDesc String?
  publicationDate DateTime?
  /// Earliest dated step we know of: the first plenum sitting or committee
  /// session that had this bill on its agenda. This is when the bill actually
  /// entered the process.
  ///
  /// `lastUpdatedDate` is NOT a usable stand-in. A bulk status change rewrites
  /// it for hundreds of bills at once — when an MK resigns, every pending bill
  /// they sponsored is stamped with that day — which piles a whole term's work
  /// into a single month. 60% of the corpus dates differently under the two.
  firstStepDate   DateTime?
  /// "plenum" | "committee" | "publication" | "lastUpdated" — which source the
  /// date came from, so a chart can say what it is actually plotting.
  firstStepSource String?
  summaryLaw   String?
  publicationSeriesDesc String?
  isContinuationBill Boolean?
  lastUpdatedDate DateTime?

  committee  Committee?    @relation(fields: [committeeId], references: [committeeId], onDelete: SetNull)
  status     Status?       @relation(fields: [statusId], references: [statusId], onDelete: SetNull)
  initiators   BillInitiator[]
  sessionItems SessionItem[]
  plenumItems  PlenumSessionItem[]
  documents    BillDocument[]

  @@index([knessetNum, lastUpdatedDate])
  @@index([publicationDate])
  @@index([firstStepDate])
  @@index([committeeId])
}

/// KNS_BillInitiator — sponsors of a bill. `isInitiator` marks the lead sponsor.
model BillInitiator {
  billInitiatorId Int     @id
  billId          Int
  personId        Int
  isInitiator     Boolean @default(false)
  ordinal         Int?
  lastUpdatedDate DateTime?

  bill   Bill   @relation(fields: [billId], references: [billId], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@index([billId])
  @@index([personId])
}

/// KNS_CommitteeSession
model CommitteeSession {
  committeeSessionId Int     @id
  number             Int?
  knessetNum         Int?
  typeDesc           String?
  committeeId        Int?
  statusDesc         String?
  location           String?
  sessionUrl         String?
  broadcastUrl       String?
  startDate          DateTime?
  finishDate         DateTime?
  note               String?
  lastUpdatedDate    DateTime?

  committee    Committee?  @relation(fields: [committeeId], references: [committeeId], onDelete: SetNull)
  items        SessionItem[]
  documents    SessionDocument[]
  participants CommitteeParticipant[]

  @@index([knessetNum, startDate])
  @@index([committeeId])
}

/// KNS_CmtSessionItem — junction between a committee session and an agenda item.
/// When `itemTypeId` is 2 the item is a bill and `itemId` is a KNS_Bill.BillID;
/// `billId` is populated only when that bill is present locally.
model SessionItem {
  cmtSessionItemId   Int     @id
  itemId             Int?
  itemTypeId         Int?
  itemTypeDesc       String?
  committeeSessionId Int
  billId             Int?
  ordinal            Int?
  statusId           Int?
  name               String?
  lastUpdatedDate    DateTime?

  session CommitteeSession @relation(fields: [committeeSessionId], references: [committeeSessionId], onDelete: Cascade)
  bill    Bill?            @relation(fields: [billId], references: [billId], onDelete: SetNull)
  status  Status?          @relation(fields: [statusId], references: [statusId], onDelete: SetNull)

  @@index([committeeSessionId])
  @@index([billId])
  @@index([itemTypeId, itemId])
}

/// KNS_DocumentCommitteeSession — protocol files (DOC/PDF) per session.
/// `filePath` is the input for the Phase 2 LLM participant extraction.
///
/// NOTE ON THE KEY: the OData $metadata declares the document id as the entity
/// key, but it is not unique — the same document is published in several
/// formats (DOC and PDF) as separate rows sharing one id, distinguished only by
/// ApplicationID. Keying on the id alone silently drops every alternate format,
/// so rows are stored under a synthetic "<documentId>:<applicationId>" id with
/// the natural pair kept unique.
model SessionDocument {
  id                         String @id
  documentCommitteeSessionId String
  applicationId              Int    @default(0)
  committeeSessionId Int
  groupTypeId        Int?
  groupTypeDesc      String?
  applicationDesc    String?
  filePath           String?
  lastUpdatedDate    DateTime?

  session CommitteeSession @relation(fields: [committeeSessionId], references: [committeeSessionId], onDelete: Cascade)
  participants CommitteeParticipant[]

  @@unique([documentCommitteeSessionId, applicationId])
  @@index([committeeSessionId])
}

/// Who was in the room for a committee sitting.
///
/// The OData service publishes no committee membership at all — the position
/// types "יו״ר ועדה" (41) and "חבר ועדה" (42) exist in KNS_Position but have
/// zero rows, and no KNS_PersonToPosition row carries a CommitteeID. The
/// protocols do carry it, in a structured `נכחו:` header, which
/// scripts/protocols/parse_attendance.py reads deterministically: verified at
/// 100% header/member/chair yield over 400 protocols, with 99.9% of 1,430
/// names matching a Person exactly.
///
/// This is attendance, not an official roster: a member who never turns up will
/// not appear. Aggregate across a committee's sittings for its composition.
model CommitteeParticipant {
  id                 Int     @id @default(autoincrement())
  committeeSessionId Int
  personId           Int?
  /// The name exactly as the protocol writes it, before matching.
  speakerName        String?
  /// chair | member | mk | invitee | legal | manager | recorder
  role               String?
  /// The role text as printed, e.g. `היו"ר, יו"ר ועדת הכלכלה`.
  roleDetail         String?
  /// Title and organisation, for invitees and officials.
  affiliation        String?
  /// Speaking turns. Only the LLM pass over the protocol body fills this in;
  /// the attendance header does not carry it.
  timesSpoken        Int     @default(0)

  sourceDocumentId   String?
  /// "protocol-header/v1" for the deterministic parser, or a provider/model
  /// string when a row came from the LLM pass.
  extractedBy        String?
  /// Only meaningful for the LLM pass. Header parsing matches exactly or not
  /// at all, and leaves this null.
  matchConfidence    Float?
  extractedAt        DateTime @default(now())

  session  CommitteeSession @relation(fields: [committeeSessionId], references: [committeeSessionId], onDelete: Cascade)
  person   Person?          @relation(fields: [personId], references: [personId], onDelete: SetNull)
  document SessionDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@unique([committeeSessionId, speakerName])
  @@index([personId])
  @@index([committeeSessionId])
  @@index([role])
}

/// Bookkeeping so the ETL can run incrementally off LastUpdatedDate.
model IngestRun {
  id          Int      @id @default(autoincrement())
  entity      String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  rowsFetched Int      @default(0)
  rowsWritten Int      @default(0)
  ok          Boolean  @default(false)
  message     String?

  @@index([entity, startedAt])
}

/// KNS_PlenumSession — a sitting of the Knesset plenum (המליאה).
model PlenumSession {
  plenumSessionId  Int     @id
  number           Int?
  knessetNum       Int?
  name             String?
  startDate        DateTime?
  finishDate       DateTime?
  isSpecialMeeting Boolean @default(false)
  lastUpdatedDate  DateTime?

  items     PlenumSessionItem[]
  documents PlenumDocument[]

  @@index([knessetNum, startDate])
}

/// KNS_PlmSessionItem — an item on a plenum sitting's agenda.
///
/// For bills (`itemTypeId` 2) `statusId` is the legislative stage the item
/// represents — "הונחה על שולחן הכנסת לקריאה ראשונה", "לדיון במליאה לקראת קריאה
/// שלישית", "התקבלה בקריאה שלישית" — which is what turns a list of sittings
/// into a readable reading history.
///
/// Note the upstream primary key is `plmPlenumSessionID`, which despite the
/// name identifies the *item*, not the sitting; `plenumSessionId` is the FK.
model PlenumSessionItem {
  plmSessionItemId Int     @id
  itemId           Int?
  itemTypeId       Int?
  itemTypeDesc     String?
  plenumSessionId  Int
  billId           Int?
  ordinal          Int?
  statusId         Int?
  name             String?
  /// True when the item was actually debated; false when merely tabled.
  isDiscussion     Boolean @default(false)
  lastUpdatedDate  DateTime?

  session PlenumSession @relation(fields: [plenumSessionId], references: [plenumSessionId], onDelete: Cascade)
  bill    Bill?         @relation(fields: [billId], references: [billId], onDelete: SetNull)
  status  Status?       @relation(fields: [statusId], references: [statusId], onDelete: SetNull)

  @@index([plenumSessionId])
  @@index([billId])
  @@index([itemTypeId, itemId])
}

/// KNS_DocumentPlenumSession — plenum transcripts ("דברי הכנסת") and related files.
///
/// NOTE ON THE KEY: the OData $metadata declares the document id as the entity
/// key, but it is not unique — the same document is published in several
/// formats (DOC and PDF) as separate rows sharing one id, distinguished only by
/// ApplicationID. Keying on the id alone silently drops every alternate format,
/// so rows are stored under a synthetic "<documentId>:<applicationId>" id with
/// the natural pair kept unique.
model PlenumDocument {
  id                      String @id
  documentPlenumSessionId String
  applicationId           Int    @default(0)
  plenumSessionId         Int
  groupTypeId             Int?
  groupTypeDesc           String?
  applicationDesc         String?
  filePath                String?
  lastUpdatedDate         DateTime?

  session PlenumSession @relation(fields: [plenumSessionId], references: [plenumSessionId], onDelete: Cascade)

  @@unique([documentPlenumSessionId, applicationId])
  @@index([plenumSessionId])
}

/// KNS_DocumentBill — the bill's own texts and attachments.
///
/// This is where the actual proposal lives: the text laid before the Knesset at
/// each reading, the enacted law, and background material. `groupTypeId` runs
/// in legislative order — 1 preliminary, 2 first reading, 4/5 second-third,
/// 8/9 the enacted law, 59 background — so ordering by it reads as progression.
///
/// NOTE ON THE KEY: the OData $metadata declares the document id as the entity
/// key, but it is not unique — the same document is published in several
/// formats (DOC and PDF) as separate rows sharing one id, distinguished only by
/// ApplicationID. Keying on the id alone silently drops every alternate format,
/// so rows are stored under a synthetic "<documentId>:<applicationId>" id with
/// the natural pair kept unique.
model BillDocument {
  id              String  @id
  documentBillId  String
  applicationId   Int     @default(0)
  billId          Int
  groupTypeId     Int?
  groupTypeDesc   String?
  applicationDesc String?
  filePath        String?
  lastUpdatedDate DateTime?

  bill Bill @relation(fields: [billId], references: [billId], onDelete: Cascade)

  @@unique([documentBillId, applicationId])
  @@index([billId, groupTypeId])
}

/// KNS_GovMinistry
///
/// Contains duplicates and placeholders ("אין נתונים", the same ministry name
/// under several ids as governments reorganise), so display names are not
/// unique — group on the id, label with the name.
model GovMinistry {
  govMinistryId   Int     @id
  name            String?
  isActive        Boolean @default(false)
  lastUpdatedDate DateTime?

  questions Question[]

  @@index([name])
}

/// KNS_Query — a written parliamentary question (שאילתה) from an MK to a minister.
///
/// The accountability value is in the two reply dates: `replyDatePlanned` is
/// when an answer was due, `replyMinisterDate` when it actually came. Both are
/// given by the service, so lateness is arithmetic rather than inference.
model Question {
  questionId      Int     @id
  number          Int?
  knessetNum      Int?
  name            String?
  typeId          Int?
  /// "רגילה" (ordinary) or "דחופה" (urgent) — urgent ones carry a shorter deadline.
  typeDesc        String?
  statusId        Int?
  personId        Int?
  govMinistryId   Int?
  submitDate      DateTime?
  replyDatePlanned DateTime?
  replyMinisterDate DateTime?

  /// Days between the due date and the actual reply; positive means late.
  /// Null while a question is unanswered — lateness for those moves with the
  /// clock, so it is computed per request instead of frozen here.
  replyDaysLate   Int?

  lastUpdatedDate DateTime?

  person   Person?      @relation(fields: [personId], references: [personId], onDelete: SetNull)
  ministry GovMinistry? @relation(fields: [govMinistryId], references: [govMinistryId], onDelete: SetNull)
  status   Status?      @relation(fields: [statusId], references: [statusId], onDelete: SetNull)
  documents QuestionDocument[]

  @@index([personId])
  @@index([govMinistryId])
  @@index([submitDate])
  @@index([replyDaysLate])
}

/// KNS_DocumentQuery — the question text and the minister's reply.
///
/// Unlike the other document tables, this one issues a distinct id per format
/// (the DOC and PDF of one question are separate ids), so the id alone is a
/// safe key here.
model QuestionDocument {
  documentQueryId String @id
  questionId      Int
  groupTypeId     Int?
  groupTypeDesc   String?
  applicationDesc String?
  filePath        String?
  lastUpdatedDate DateTime?

  question Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@index([questionId])
}
